{
  "name": "mandegar",
  "version": "0.1.0",
  "private": true,
  "description": "Mandegar — home appliances",
  "packageManager": "pnpm@11.8.0+sha512.c1f5e7c4cb241c8f174b743851d82f42b802324afc8b0f116b96adb15aa06664948dde36960a3ba1079ba5b4b29dd0140135b94b5b5f5263592249d68e555f26",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --test --conditions=react-server 'src/**/*.test.ts'",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --conditions=react-server src/server/db/seed.ts",
    "db:backfill-placeholders": "tsx --conditions=react-server src/server/db/backfill-placeholders.ts",
    "standalone:assemble": "cp -R public .next/standalone/ && cp -R .next/static .next/standalone/.next/",
    "start:standalone": "node .next/standalone/server.js",
    "deploy:release": "bash deploy/release.sh"
  },
  "dependencies": {
    "@elysia/eden": "1.4.10",
    "@hookform/resolvers": "5.9.1",
    "@node-rs/argon2": "2.2.2",
    "@resvg/resvg-js": "2.6.2",
    "@sinclair/typebox": "0.34.52",
    "altcha-lib": "2.6.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "elysia": "1.4.30",
    "exact-mirror": "0.2.7",
    "file-type": "22.2.0",
    "lenis": "1.3.26",
    "lucide-react": "1.57.0",
    "marked": "18.1.1",
    "motion": "14.2.0",
    "next": "16.4.1",
    "nuqs": "2.10.2",
    "openapi-types": "12.1.3",
    "otplib": "13.5.0",
    "postgres": "3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.90.0",
    "satori": "0.60.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "tailwind-merge": "3.7.0",
    "uqr": "0.1.3",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "optionalDependencies": {
    "@aws-sdk/client-s3": "3.1141.0"
  }
}
